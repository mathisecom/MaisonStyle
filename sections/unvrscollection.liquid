{% style %}

  #shopify-section-{{ section.id }} {
    --uc-bg: {{ section.settings.background_color }};
    --uc-text: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .uc-section {
    width: 100%;
    background: var(--uc-bg);
  }

  #shopify-section-{{ section.id }} .uc-container {
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;

    padding:
      {{ section.settings.padding_top }}px
      {{ section.settings.padding_horizontal }}px
      {{ section.settings.padding_bottom }}px;
  }

  /* ==========================
     TITRE
  ========================== */

  #shopify-section-{{ section.id }} .uc-header {
    margin-bottom: {{ section.settings.title_spacing }}px;
    text-align: {{ section.settings.title_alignment }};
  }

  #shopify-section-{{ section.id }} .uc-title {
    margin: 0;

    color: var(--uc-text);

    font-family: var(--font-heading-family, inherit);
    font-style: var(--font-heading-style, normal);
    font-weight: {{ section.settings.title_weight }};

    font-size: {{ section.settings.title_size }}px;
    line-height: 1.15;

    letter-spacing: -0.025em;
  }

  #shopify-section-{{ section.id }} .uc-subtitle {
    max-width: 700px;

    margin:
      {{ section.settings.subtitle_spacing }}px
      auto
      0;

    color: var(--uc-text);

    font-family: var(--font-body-family, inherit);
    font-size: {{ section.settings.subtitle_size }}px;
    line-height: 1.55;

    opacity: 0.72;
  }

  #shopify-section-{{ section.id }} .uc-header--left .uc-subtitle {
    margin-left: 0;
    margin-right: auto;
  }

  #shopify-section-{{ section.id }} .uc-header--right .uc-subtitle {
    margin-left: auto;
    margin-right: 0;
  }

  /* ==========================
     GRILLE
  ========================== */

  #shopify-section-{{ section.id }} .uc-grid {
    display: grid;

    grid-template-columns:
      repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));

    column-gap: {{ section.settings.column_gap }}px;
    row-gap: {{ section.settings.row_gap }}px;
  }

  /* ==========================
     CARTE
  ========================== */

  #shopify-section-{{ section.id }} .uc-card {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .uc-card__link {
    display: block;

    color: inherit;
    text-decoration: none;
  }

  /* IMAGE */

  #shopify-section-{{ section.id }} .uc-card__image-wrapper {
    position: relative;

    width: 100%;

    aspect-ratio: {{ section.settings.image_ratio }};

    overflow: hidden;

    border-radius: {{ section.settings.image_radius }}px;

    background: {{ section.settings.image_background }};
  }

  #shopify-section-{{ section.id }} .uc-card__image {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: {{ section.settings.image_fit }};
    object-position: center;

    transition: transform 0.45s ease;
  }

  #shopify-section-{{ section.id }}
  .uc-card__link:hover
  .uc-card__image {
    transform: scale({{ section.settings.hover_zoom | divided_by: 100.0 }});
  }

  /* PLACEHOLDER */

  #shopify-section-{{ section.id }} .uc-card__placeholder {
    width: 100%;
    height: 100%;

    display: flex;
    align-items: center;
    justify-content: center;

    color: rgba(0, 0, 0, 0.18);
  }

  #shopify-section-{{ section.id }} .uc-card__placeholder svg {
    width: 100%;
    height: 100%;
  }

  /* TITRE SOUS IMAGE */

  #shopify-section-{{ section.id }} .uc-card__title {
    margin:
      {{ section.settings.card_title_spacing }}px
      0
      0;

    color: var(--uc-text);

    font-family: var(--font-body-family, inherit);
    font-style: var(--font-body-style, normal);
    font-weight: {{ section.settings.card_title_weight }};

    font-size: {{ section.settings.card_title_size }}px;
    line-height: 1.3;

    text-align: {{ section.settings.card_text_alignment }};
  }

  /* ==========================
     TABLETTE
  ========================== */

  @media screen and (max-width: 989px) {

    #shopify-section-{{ section.id }} .uc-container {
      padding-left: 20px;
      padding-right: 20px;
    }

    #shopify-section-{{ section.id }} .uc-grid {
      grid-template-columns:
        repeat({{ section.settings.columns_tablet }}, minmax(0, 1fr));

      column-gap: {{ section.settings.tablet_gap }}px;
      row-gap: {{ section.settings.tablet_row_gap }}px;
    }

  }

  /* ==========================
     MOBILE
  ========================== */

  @media screen and (max-width: 749px) {

    #shopify-section-{{ section.id }} .uc-container {
      padding:
        {{ section.settings.mobile_padding_top }}px
        {{ section.settings.mobile_padding_horizontal }}px
        {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .uc-header {
      margin-bottom: {{ section.settings.mobile_title_spacing }}px;
      text-align: {{ section.settings.mobile_title_alignment }};
    }

    #shopify-section-{{ section.id }} .uc-title {
      font-size: {{ section.settings.mobile_title_size }}px;
      line-height: 1.18;
    }

    #shopify-section-{{ section.id }} .uc-subtitle {
      margin-top: 10px;
      font-size: {{ section.settings.mobile_subtitle_size }}px;
    }

    #shopify-section-{{ section.id }} .uc-grid {
      grid-template-columns:
        repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));

      column-gap: {{ section.settings.mobile_gap }}px;
      row-gap: {{ section.settings.mobile_row_gap }}px;
    }

    #shopify-section-{{ section.id }} .uc-card__image-wrapper {
      border-radius: {{ section.settings.mobile_image_radius }}px;
    }

    #shopify-section-{{ section.id }} .uc-card__title {
      margin-top: {{ section.settings.mobile_card_title_spacing }}px;

      font-size: {{ section.settings.mobile_card_title_size }}px;

      text-align: {{ section.settings.mobile_card_alignment }};
    }

  }

{% endstyle %}


<section class="uc-section">

  <div class="uc-container">

    {% if section.settings.title != blank or section.settings.subtitle != blank %}

      <div
        class="uc-header uc-header--{{ section.settings.title_alignment }}"
      >

        {% if section.settings.title != blank %}

          <h2 class="uc-title">
            {{ section.settings.title }}
          </h2>

        {% endif %}

        {% if section.settings.subtitle != blank %}

          <div class="uc-subtitle">
            {{ section.settings.subtitle }}
          </div>

        {% endif %}

      </div>

    {% endif %}


    <div class="uc-grid">

      {% for block in section.blocks %}

        {% liquid

          assign selected_collection = block.settings.collection

          assign card_title = block.settings.custom_title

          if card_title == blank and selected_collection != blank
            assign card_title = selected_collection.title
          endif

          assign card_link = block.settings.custom_link

          if card_link == blank and selected_collection != blank
            assign card_link = selected_collection.url
          endif

          assign card_image = block.settings.custom_image

          if card_image == blank and selected_collection != blank
            assign card_image = selected_collection.image
          endif

        %}


        <div
          class="uc-card"
          {{ block.shopify_attributes }}
        >

          {% if card_link != blank %}

            <a
              href="{{ card_link }}"
              class="uc-card__link"
            >

          {% else %}

            <div class="uc-card__link">

          {% endif %}

              <div class="uc-card__image-wrapper">

                {% if card_image != blank %}

                  {{
                    card_image
                    | image_url: width: 1200
                    | image_tag:
                      class: 'uc-card__image',
                      loading: 'lazy',
                      widths: '240, 360, 480, 600, 800, 1000, 1200',
                      sizes: '(max-width: 749px) 50vw, (max-width: 989px) 33vw, 25vw'
                  }}

                {% else %}

                  <div class="uc-card__placeholder">

                    {{ 'collection-1' | placeholder_svg_tag }}

                  </div>

                {% endif %}

              </div>


              {% if card_title != blank %}

                <p class="uc-card__title">
                  {{ card_title }}
                </p>

              {% endif %}


          {% if card_link != blank %}

            </a>

          {% else %}

            </div>

          {% endif %}

        </div>

      {% endfor %}

    </div>

  </div>

</section>


